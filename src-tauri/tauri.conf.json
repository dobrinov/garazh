{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Garazh",
  "mainBinaryName": "avtoservis",
  "version": "0.4.0",
  "identifier": "bg.avtoservis.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Гараж",
        "width": 1360,
        "height": 880,
        "minWidth": 1024,
        "minHeight": 640,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Bulgarian",
          "English"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAyQTVDQ0IwQzIxQjQzMzQKUldRMFF4dkNzTXlsQWtEc28wUkR5MGo3SjVBWXJwcEoySHdkd3VFNE1qV2p5bnZveisyMXVVRVcK",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
